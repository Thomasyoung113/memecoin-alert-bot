# Telegram Bot — get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your Telegram chat/user ID — start a chat with your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id
TELEGRAM_CHAT_ID=your_chat_id_here

# Dashboard security — set a token to protect /api/* endpoints
# If empty, dashboard has no authentication (warning logged on startup)
DASHBOARD_TOKEN=your_token_here